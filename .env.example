# Default: free local narration with VOICEVOX Nemo / VOICEVOX
ASTRO_TTS_PROVIDER=voicevox
ASTRO_VOICEVOX_URL=http://127.0.0.1:50021

# Leave empty to automatically use the first available style.
# Run "npm run voices" to list IDs.
ASTRO_VOICEVOX_SPEAKER_ID=

# VOICEVOX tuning
ASTRO_VOICEVOX_SPEED=1.0
ASTRO_VOICEVOX_PITCH=0.0
ASTRO_VOICEVOX_INTONATION=1.0
ASTRO_VOICEVOX_VOLUME=1.0

# Optional paid cloud fallback: OpenAI
OPENAI_API_KEY=
ASTRO_OPENAI_VOICE=marin
ASTRO_OPENAI_TTS_MODEL=gpt-4o-mini-tts
